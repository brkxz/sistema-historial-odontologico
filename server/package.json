{
  "name": "dental-history-server",
  "version": "1.0.0",
  "description": "Backend del Sistema de Historial Odontológico Digital",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start":      "node server.js",
    "dev":        "node --watch server.js",
    "seed":       "node seeders/initialData.js",
    "test":       "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui":    "vitest --ui"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.3",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.4",
    "supertest": "^7.3.1",
    "vitest": "^5.0.4"
  }
}

# =============================================
# BASE DE DATOS
# =============================================
# PostgreSQL en la nube (Neon, Supabase, etc.)
# Si no se configura, usará SQLite local automáticamente
DATABASE_URL=postgresql://usuario:contraseña@host/nombre_db?sslmode=require

# =============================================
# SEGURIDAD Y JWT
# =============================================
# Genera un secreto seguro con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_SEGURO_DE_AL_MENOS_64_CARACTERES

# =============================================
# ENTORNO
# =============================================
# Opciones: development | production
NODE_ENV=development

# =============================================
# TOKENS PARA CONSULTA DE DNI (RENIEC)
# =============================================
# Opción 1: Regístrate gratis en https://decolecta.com
RENIEC_API_TOKEN=tu_token_de_decolecta_aqui

# Opción 2 (Respaldo): Regístrate gratis en https://apiperu.dev
APIPERU_DEV_TOKEN=tu_token_de_apiperu_dev_aqui

# =============================================
# OAUTH - LOGIN SOCIAL
# =============================================
# Google: Obtén tu Client ID en https://console.cloud.google.com/
GOOGLE_CLIENT_ID=tu_google_client_id_aqui

# =============================================
# IA - Groq API (Llama/Qwen - 14,400 req/día gratis)
# =============================================
# Regístrate en https://console.groq.com
GROQ_API_KEY=tu_groq_api_key_aqui
# GROQ_MODEL=qwen/qwen3.8-27b

# =============================================
# FRONTEND URL (para CORS en producción)
# =============================================
# FRONTEND_URL=https://tu-app.vercel.app
